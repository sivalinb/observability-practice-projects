      "type": "counter",
      "unit": "requests",
      "owner": "checkout",
      "samples": [
        {
          "labels": {
            "service": "checkout",
            "route": "/checkout",
            "status": "200"
          },
          "value": 150
        },
        {
          "labels": {
            "service": "checkout",
            "route": "/checkout",
