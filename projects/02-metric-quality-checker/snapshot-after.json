      "unit": "seconds",
      "owner": "checkout",
      "buckets": [
        0.1,
        0.5,
        1.0,
        5.0
      ],
      "samples": [
        {
          "labels": {
            "service": "checkout",
            "route": "/checkout",
            "status": "200"
